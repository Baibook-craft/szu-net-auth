# =============================================================================
#  /etc/config/szu-netauth  ——  校园网自动认证配置
#
#  ⚠ 本文件以**明文**保存校园网卡号与密码，文件权限应为 600（仅 root 可读）。
#     不要把它复制到别处、不要提交到任何代码仓库、不要随备份外传。
#
#  改完配置后要么在 LuCI 里点「保存并应用」，要么执行
#      uci commit szu-netauth
#  procd 的 reload trigger 会唤醒常驻循环去重读配置（最多 5 秒生效）。
# =============================================================================

config szu-netauth 'global'
	# 总开关：0 = 只检测不登录（服务仍在跑，状态页会显示「已停用」）
	option enabled '1'

	# 多账号：登录失败后要不要换下一个账号再试。
	#   1 = 换（默认）。按下面的账号列表从上到下轮，全部试过再绕回第一个
	#   0 = 不换。永远只用账号列表里的**第一个**
	option auto_switch '1'

	# 常规联网检测周期（秒）。默认 3600 = 60 分钟。
	# 这是「心跳」：每隔这么久确认一次网络是否还通。
	option net_check '3600'

	# 不在校园网时的重新检测周期（秒）
	option campus_check '3600'

	# 检测到离线后，重新尝试登录的间隔（秒）。默认 60 = 每分钟一次。
	option retry_interval '60'

	# 单轮重连最多尝试几次。用尽即停手，等下一个 net_check 周期再检测。
	# 默认 5。填 0 或负数会被 clamp 到 1。
	# 注意：这是**总的尝试次数**上限，多账号时每个账号各占一次。
	option retry_max '5'

	# 联网判定方式：
	#   http      只用 HTTP 探测（最快，完全不依赖 ICMP）
	#   http+ping HTTP 为判据，再用 ICMP 给「为什么离线」分类（默认，推荐）
	#   ping      只用 ICMP（不推荐：校园网关可能丢弃 ICMP；另有 IPv6 绕过坑）
	# 注意：ICMP 一定会以 -4（强制 IPv4）发出，否则会走 wan6 导致假在线。
	option net_check_method 'http+ping'

	# ICMP 探测目标。想完全避开 DNS 依赖可以直接填 IP，例如 223.5.5.5
	option ping_host 'www.baidu.com'

	# 登录线路，空格分隔。常见网段实测只有 eportal 可达。
	# 可选：eportal / drcom_wifi / drcom_nth
	option login_paths 'eportal'

	# 两次登录之间的绝对最小间隔（秒）——防连点、避免触发登录风控
	option login_min_interval '30'

	# 是否把运行日志落盘到 /etc/szu-netauth/state.log
	# 默认 0：日志只进 syslog 的内存环形缓冲（不磨损 flash）
	option persist_log '0'

# =============================================================================
#  账号列表（可以有任意多个）
# -----------------------------------------------------------------------------
#  ★ 顺序就是认证顺序，规则如下：
#
#    1. 开机后（以及每一轮重新开始重连时）**固定先试最上面那个账号**；
#    2. 这一次没通过 → 等 retry_interval 秒后试**下一个**账号；
#    3. 试到列表末尾就绕回最上面，如此循环，直到用满 retry_max 次就停手；
#    4. 只要有一次认证成功，下次重连又从最上面那个账号重新开始。
#
#    在 LuCI 的「服务 → 校园网认证 → 设置」页里，可以拖行首的 ☰ 图标、
#    或者点行尾的 ▲▼ 按钮来调整顺序；最上面那一行就是「首次尝试账号」。
#
#  字段说明：
#    label     显示名。留空也行，界面会按位置显示成「账号 1 / 账号 2」
#    cardid    校园网卡号（注意：是校园网账号，不是学号）
#    password  校园网密码（明文，权限 600）
#    enabled   0 = 临时停用这个账号（保留在列表里，但认证时不参与轮换）
# =============================================================================

config account 'main'
	option label '主号'
	option cardid ''
	option password ''
	option enabled '1'
